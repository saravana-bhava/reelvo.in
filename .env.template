# File: .env.template

# ─────────────────────────────────────────────
# ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────
FLASK_ENV=production
FLASK_SECRET_KEY=<your-flask-secret-key>         # Use a secure random value (e.g., os.urandom or secrets.token_hex(32))
HOST=reelvo.in
PORT=5000
PROTOCOL=https
LOG_LEVEL=INFO
DEFAULT_EMAIL=<your-admin-email>
DISABLE_CACHE=false
SLEEP_BETWEEN_RUNS=2

# ─────────────────────────────────────────────
# SMTP EMAIL SETTINGS (For password reset & alerts)
# ─────────────────────────────────────────────
ALERT_EMAIL=<your-admin-email>
SMTP_FROM_EMAIL=<your-smtp-email>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-email>
SMTP_PASSWORD=<your-smtp-password>
SMTP_SENDER_NAME=Reelvo Support
SMTP_USE_TLS=true

# ─────────────────────────────────────────────
# OPENAI / OPENROUTER CONFIGURATION
# ─────────────────────────────────────────────
USE_OPENAI=true
PROVIDER=openrouter
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat-v3-0324:free

# ─────────────────────────────────────────────
# GOOGLE LOGIN INTEGRATION
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your google client id>
GOOGLE_CLIENT_SECRET=<your google client secret>
GOOGLE_DISCOVERY_URL="https://accounts.google.com/.well-known/openid-configuration"

# ─────────────────────────────────────────────
# GOOGLE CLOUD TTS SETTINGS
# ─────────────────────────────────────────────
USE_GOOGLE_CLOUD_TTS=true
GOOGLE_APPLICATION_CREDENTIALS=<path to credentials.json>
GOOGLE_CLOUD_TTS_VOICE=hi-IN-Wavenet-A

# ─────────────────────────────────────────────
# GOOGLE DRIVE INTEGRATION
# ─────────────────────────────────────────────
UPLOAD_TO_DRIVE=true
GOOGLE_DRIVE_PARENT_FOLDER_ID=<google drive parent folder id>
GOOGLE_OAUTH_CREDENTIALS=<path to oauth.json>

# ─────────────────────────────────────────────
# INSTAGRAM GRAPH API
# ─────────────────────────────────────────────
POST_TO_IG=true
FB_APP_ID=<your-fb-app-id>
FB_APP_SECRET=<your-fb-app-secret>

# ─────────────────────────────────────────────
# PEXELS IMAGE API
# ─────────────────────────────────────────────
USE_PEXELS=true
PEXELS_API_KEY=<your-pexels-api-key>

# ─────────────────────────────────────────────
# PIXABAY IMAGE API
# ─────────────────────────────────────────────
USE_PIXABAY=true
PIXABAY_API_KEY=<your-pixabay-api-key>

# ─────────────────────────────────────────────
# FREESOUND AUDIO API
# ─────────────────────────────────────────────
FREESOUND_API_CLIENT=<your-freesound-client-id>
FREESOUND_API_KEY=<your-freesound-api-key>
