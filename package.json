{
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11"
  },
  "name": "reelvo.ai",
  "version": "1.0.0",
  "description": "An AI-powered platform that **automatically generates and schedules Instagram Reels** using GPT scripts, TTS voices, and stock video footage — optionally auto-posted to Instagram and backed up on Google Drive.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./assets/css/input.css -o ./static/css/style.css --content './templates/**/*.html' --content './routes/**/*.py' --content './assets/css/**/*.css' --content './static/css/safelist.css'"
  },
