# .gitignore

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/

# Environment variables and secrets
.env
*.env
.env.*
secure/

# Editor and IDE settings
.vscode/
.idea/
*.swp
*.swo

# Output media and generated assets
output/
*.mp4
*.avi
*.mov
*.png
*.jpg

# Build artifacts
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.bak

# System files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Apache config (local only)
.htaccess

# Test utilities (not for production)
test/

*.spec     # If using PyInstaller for packaging

.pytest_cache/

docs/
temp/
